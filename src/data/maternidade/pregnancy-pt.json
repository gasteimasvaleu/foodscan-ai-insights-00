  "exams": {
    "title": "Exames por Trimestre",
    "trimester1": {
      "title": "1º Trimestre",
      "items": [
        {
          "name": "Beta-HCG",
          "description": "Confirma a gravidez e monitora níveis hormonais",
          "when": "Semanas 4-6"
        },
        {
          "name": "Ultrassom transvaginal",
          "description": "Visualiza saco gestacional e batimentos cardíacos",
          "when": "Semanas 6-8"
        },
        {
          "name": "Tipagem sanguínea e fator Rh",
          "description": "Identifica tipo sanguíneo e incompatibilidade",
          "when": "Primeira consulta"
        },
        {
          "name": "Hemograma completo",
          "description": "Verifica anemia e saúde geral",
          "when": "Primeira consulta"
        },
        {
          "name": "Glicemia de jejum",
          "description": "Rastreia diabetes gestacional",
          "when": "Primeira consulta"
        },
        {
          "name": "Sorologias (HIV, Sífilis, Hepatites, Toxoplasmose, Rubéola, CMV)",
          "description": "Detecta infecções que podem afetar o bebê",
          "when": "Primeira consulta"
        },
        {
          "name": "Urina tipo I e urocultura",
          "description": "Detecta infecções urinárias",
          "when": "Primeira consulta"
        },
        {
          "name": "Translucência nucal",
          "description": "Rastreia síndromes cromossômicas",
          "when": "Semanas 11-14"
        },
        {
          "name": "NIPT (opcional)",
          "description": "Teste genético não invasivo",
          "when": "A partir da semana 10"
        }
      ]
    },
    "trimester2": {
      "title": "2º Trimestre",
      "items": [
        {
          "name": "Ultrassom morfológico",
          "description": "Avalia anatomia fetal detalhadamente",
          "when": "Semanas 18-24"
        },
        {
          "name": "Teste de tolerância à glicose (TOTG)",
          "description": "Diagnóstico de diabetes gestacional",
          "when": "Semanas 24-28"
        },
        {
          "name": "Hemograma",
          "description": "Monitora anemia",
          "when": "Segundo trimestre"
        },
        {
          "name": "Sorologias (repetição)",
          "description": "Reconfirma status de infecções",
          "when": "Segundo trimestre"
        },
        {
          "name": "Ultrassom de crescimento",
          "description": "Acompanha desenvolvimento fetal",
          "when": "Conforme necessidade"
        }
      ]
    },
    "trimester3": {
      "title": "3º Trimestre",
      "items": [
